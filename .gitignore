# 本机 VS Code 配置包含绝对路径
/.vscode/c_cpp_properties.json
/.vscode/settings.json
/.vscode/tasks.json

# 项目生成的 CMake 和原生构建目录
/build/
/PumpkinShooter/build/
/PumpkinShooter/cmake-build-*/
/PumpkinShooter/out/
